{
  "description": "Pulls Google Search Console clicks for blog posts every morning to rank the Trending section",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Daily Blog Trends Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_blog_trends_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_trends": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncBlogTrends",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Update trending posts",
            "description": "From Google Search Console"
          }
        }
      }
    ]
  }
}